{
  "name": "bookstore-manager-cli",
  "version": "1.0.0",
  "description": "CLI para gerenciamento de autores, livros, clientes e empréstimos com Node.js, TypeScript e PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "psql -U postgres -f database/schema.sql"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
